# Connected desktop analysis uses OpenRouter. Fill the key privately.
OPENROUTER_API_KEY=
# Example only: replace with an available model ID; do not treat this as a real model.
CODEPROOF_MODEL=provider/model-id
# Optional for separately constructed GeminiProvider; not selected by the desktop launcher.
GEMINI_API_KEY=

# Launcher loads this repository's .env; inherited process variables take precedence.
# The service always binds to 127.0.0.1; host override is not supported.
BACKEND_PORT=8000
# Omit CODEPROOF_TOKEN to generate a fresh pairing token at startup.
# Keep tokens/API keys out of logs and reports.

# Docker validation requires a separately provisioned trusted image.
SANDBOX_DOCKER_IMAGE=codeproof/sandbox:latest
SANDBOX_CPU_LIMIT=2
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_TIMEOUT=300
