"""Signing configuration regressions, executed only by the Docker test runner."""
import os
from pathlib import Path
import subprocess
import sys

import pytest
from jose import JWTError, jwt
import auth

BACKEND = Path(__file__).resolve().parents[1] / "backend"
KEY_VARIABLE = "CODEPROOF_DUMMY_SIGNING_KEY"

def run_with_key(value, program="import auth"):
    environment = dict(os.environ)
    environment.pop(KEY_VARIABLE, None)
    if value is not None:
        environment[KEY_VARIABLE] = value
    return subprocess.run([sys.executable, "-c", program], cwd=BACKEND,
                          env=environment, capture_output=True, text=True, timeout=15)

@pytest.mark.parametrize("value", [None, "", "short", " " * 40])
def test_missing_or_invalid_key_fails_without_echo(value):
    result = run_with_key(value)
    assert result.returncode != 0
    assert "CODEPROOF_DUMMY_SIGNING_KEY" in result.stderr
    assert "at least 32" in result.stderr
    if value and value.strip():
        assert value not in result.stderr

def test_configured_key_signs_and_verifies():
    encoded = auth.create_access_token({"sub": "fixture-user"})
    decoded = jwt.decode(encoded, os.environ[KEY_VARIABLE], algorithms=["HS256"])
    assert decoded["sub"] == "fixture-user" and "exp" in decoded

def test_mismatched_key_rejected():
    encoded = auth.create_access_token({"sub": "fixture-user"})
    other_material = "different-harmless-fixture-material-20261002"
    with pytest.raises(JWTError):
        jwt.decode(encoded, other_material, algorithms=["HS256"])

def test_rotation_invalidates_previously_signed_token():
    encoded = auth.create_access_token({"sub": "fixture-user"})
    environment = dict(os.environ)
    environment[KEY_VARIABLE] = "rotated-harmless-fixture-material-20261002"
    environment["OLD_FIXTURE_TOKEN"] = encoded
    program = "import os, auth; from jose import JWTError, jwt\ntry:\n jwt.decode(os.environ['OLD_FIXTURE_TOKEN'], auth.SECRET_KEY, algorithms=['HS256'])\nexcept JWTError:\n raise SystemExit(0)\nraise SystemExit(1)"
    result = subprocess.run([sys.executable, "-c", program], cwd=BACKEND,
                            env=environment, capture_output=True, text=True, timeout=15)
    assert result.returncode == 0

def test_original_environment_value_not_trimmed():
    program = "import os, auth; assert auth.SECRET_KEY == os.environ['CODEPROOF_DUMMY_SIGNING_KEY']"
    result = run_with_key("harmless-fixture-material-with-more-than-32-bytes", program)
    assert result.returncode == 0
